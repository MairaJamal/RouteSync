{
  // Standalone type-check for the Vite/React frontend (`.tsx`), which the root
  // `tsconfig.json` deliberately excludes (it only compiles `src/**/*.ts` to
  // `dist` for the backend/tests). Run with:
  //   node_modules/.bin/tsc -p tsconfig.frontend.json
  // It pulls in the pure backend modules the frontend imports (types, safety,
  // carbonImpact, matchEngine, matchPipeline, ...) transitively; those already
  // pass the root build, so this surfaces real issues in the `.tsx` layer only.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src/frontend/**/*.ts", "src/frontend/**/*.tsx"]
}
