SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-public-key
# Backend port. The Express server (src/server.ts) listens here and the Vite
# dev proxy forwards /api/* to it — both read this single value, so they can't drift.
PORT=3001

# Leave VITE_API_URL empty in dev: the frontend then calls relative /api/*
# paths and the Vite dev proxy (vite.config.ts) forwards them to the backend
# on PORT. Only set an absolute URL here if the API lives on a different host.
VITE_API_URL=
VITE_DEMO_USER_ID=your-demo-user-uuid
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_DEMO_USER_EMAIL=demo@example.com
VITE_DEMO_USER_PASSWORD=your-demo-user-password

# Natural-language trip request parsing (src/nlpParser.ts) using Groq
QWEN_API_KEY=your-groq-api-key
QWEN_BASE_URL=https://api.groq.com/openai/v1
QWEN_MODEL=llama-3.3-70b-versatile
